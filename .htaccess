<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Keamanan: Blokir akses ke file sensitif di root directory
    RewriteRule ^(\.env|\.git|\.editorconfig|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml) - [F,L,NC]
    RewriteRule ^(storage/logs/|storage/framework/|bootstrap/cache/) - [F,L,NC]

    # 2. Jangan lakukan rewrite jika URL sudah menuju ke folder /public/
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # 3. Teruskan semua request ke subfolder public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Nonaktifkan directory browsing
Options -Indexes
